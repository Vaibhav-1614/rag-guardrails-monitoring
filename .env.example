# LLM providers (free tiers). Without keys the service answers with the offline extractive generator.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Langfuse tracing (Hobby tier). Without keys traces go to data/traces/ as JSONL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Lets the traffic simulator tag requests as env=sim and backdate them (headers ignored when unset).
SIM_SECRET=

# Nightly monitoring
MONITOR_TARGET_URL=          # production base URL for the nightly golden-set run
DISCORD_WEBHOOK_URL=         # optional alert webhook (or SLACK_WEBHOOK_URL)

# Any setting can be overridden: RAG__<SECTION>__<KEY>, e.g.
# RAG__GUARDS_CONFIG=configs/guards/v1.yaml
# RAG__EMBEDDER__BACKEND=lsa
